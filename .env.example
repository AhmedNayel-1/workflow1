# =====================================================================
# إعدادات البيئة لمنظومة إدارة السكرتارية والمراسلات والدورة المستندية
# انسخ هذا الملف إلى .env وعدّل القيم قبل التشغيل
# =====================================================================
DJANGO_SECRET_KEY=replace-with-a-unique-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# خيار قاعدة البيانات: sqlite (للتطوير والاختبار) أو mssql (لـ SQL Server في الإنتاج)
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# إعدادات SQL Server (تُستخدم عند ضبط DB_ENGINE=mssql)
DB_NAME=CorrespondenceDB
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=1433
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# مسار تخزين المرفقات خارج مجلد التطبيق ومجلدات Static
# في الإنتاج (Windows Server VM) يُنصح بمسار مخصص مثل: D:\EnterpriseStorage\CorrespondenceVault
SECURE_STORAGE_ROOT=storage_vault

# الحد الأقصى لحجم المرفق بالميجابايت
MAX_UPLOAD_SIZE_MB=25

# مسار حفظ النسخ الاحتياطية (يجب أن يكون خارج مجلد الكود - الافتراضي: ..\correspondence_backups)
BACKUP_ROOT=..\correspondence_backups
